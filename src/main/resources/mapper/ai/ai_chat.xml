<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace='ai_chat'>
    
    <!-- 根据图层名称查询表名 -->
    <select id="getTableNameByLayerName" parameterType="java.util.HashMap" resultType="java.util.HashMap">
        SELECT table_name FROM gather_layer_config WHERE name = #{layerName}
    </select>
    
    <!-- 查询指定表的总条数 -->
    <select id="getTableCount" parameterType="java.util.HashMap" resultType="java.lang.Integer">
        SELECT COUNT(*) FROM ${tableName}
    </select>

</mapper>
